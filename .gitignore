# Rust Build-Artefakte
/varg-compiler/target/
/varg-compiler/.vargc_cache/

# VS Code Extension Build
/varg-vscode/*.vsix
/varg-vscode/node_modules/

# OS/Editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/settings.json

# Binaries
*.exe
*.dll
*.so
*.dylib

# Env/Secrets
.env
*.key
*.pem

# Claude Agent Memory (project-specific, not shared)
.claude/

# C# Benchmarks (dev-only, not part of the language)
/bench-csharp/bin/
/bench-csharp/obj/

# Temporary build outputs
*.tmp
*.bak
*.pdb

# Dev scratch files in varg-compiler root
/varg-compiler/bench*.rs
/varg-compiler/bench*.varg
/varg-compiler/bench*.ts
/varg-compiler/main.rs
/varg-compiler/main.varg
/varg-compiler/benchmark_realistic.*
/varg-compiler/test_interpolation.*
/varg-compiler/token_compare_*
/varg-compiler/build_out.txt
/varg-compiler/check_out.txt
/varg-compiler/@L_tests/
/.vargc_cache/

# Dev-only temp files
/varg-compiler/build.log
/varg-compiler/error.log
/varg-compiler/output.log
/varg-compiler/output.txt
/varg-compiler/check_output.txt

# Test output directories
/varg-compiler/@L_tests/

# Runtime persistence databases (generated by graph/vector/memory modules)
*.graph.db
*.vector.db

# Release archives (uploaded to GitHub Releases, not stored in repo)
*.zip
*.tar.gz

# Compiled example outputs (only .varg source files belong here)
examples/*.rs

# Dev-only folders
/scratch/
/release-staging/
/bench-csharp/
# benchmarks/ is the committed comparison suite: sources in four languages, the runner,
# and the recorded results. Only build output stays out, so that a reader can rerun it and
# compare against what is checked in. It used to be ignored wholesale, which left the
# performance table in the README standing on numbers nobody else could reproduce.
/benchmarks/**/bin/
/benchmarks/**/obj/
/benchmarks/**/node_modules/
/benchmarks/**/.vargc_cache/
/benchmarks/**/*.exe
/benchmarks/**/*.pdb
# A hand-maintained page repeating the measured figures, with no generator and nothing
# checking it. BENCHMARKS.md is written by run_all.py and is the copy that stays true.
/benchmarks/benchmarks.html
# vargc emits the generated Rust beside the source; it is output, not a source file.
/benchmarks/**/*.rs
# Nothing in the runner reads token_compare/, so nothing keeps it honest or even builds it.
# An unrun file that looks like part of a suite is how a suite starts to lie.
/benchmarks/token_compare/
/varg-web-ide/
/varg-compiler/benchmarks/

# Dev-only root files
/filter_msg.py

# Internal planning docs
/docs/F41_varg-upgrade-plan.md
/docs/VARG_NEXT_10.md
/docs/VARG_UPGRADE_PLAN.md
/docs/WAVES_35_39_PLAN.md
"docs/Textdokument (neu).txt"

# Training data generators
docs/gen_training*.py

# Binaries built beside their source by `vargc build`
tools/**/*.exe
tools/**/.vargc_cache/

#  writes the executable into the current directory
/tutor.exe
/tutor

# Python bytecode, never a source file.
__pycache__/
*.pyc
