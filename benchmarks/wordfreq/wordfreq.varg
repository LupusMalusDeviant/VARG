// Word frequency over 200,000 words, all distinct: build text, split, count, sort the keys.
// Allocation- and hash-heavy, which is where Varg is slowest ~ it is here because a benchmark
// suite that only contains what a language wins is advertising.
fn build(int n) -> string {
    var parts = [];
    var i = 0;
    while i < n {
        parts.push("item-" + i.to_string());
        i = i + 1;
    }
    return parts.join(" ");
}

agent Main {
    public void Run() {
        var text = build(200000);
        var start = time_millis();
        // `ordered_map`, not `map`, because the other three languages here have no choice:
        // Python's dict and JavaScript's Map both keep insertion order, and C#'s Dictionary
        // does in practice for an insert-only run. A plain Varg `map` hands its keys back in
        // hash order, so the sort below received a shuffled list while the others received a
        // nearly-ordered one — the whole of the gap, measured. This is the comparable
        // structure, and it is what makes this a comparison.
        ordered_map<string, int> counts = {"seed": 0};
        foreach (w in text.split(" ")) {
            counts[w] = (counts[w] or 0) + 1;
        }
        var keys = counts.keys();
        keys.sort();
        var elapsed = time_millis() - start;
        print $"distinct = {keys.len()}";
        print $"Time: {elapsed}ms";
    }
}
