// Collections: build a list, filter, map, sum, then count words into a map.
// Every language here does the same work in the same order. It did not before: this file ran a
// plain `while` loop adding to an accumulator while the C# and TypeScript versions built a
// 100,000-element list and ran it through LINQ / array methods. The comparison was partly
// between two different programs.
fn main() {
    var start = time_millis()

    var numbers = []
    var i = 0
    while i < 100000 {
        numbers.push(i)
        i += 1
    }

    var doubled = numbers.filter((n) => n % 2 == 0).map((n) => n * 2)
    var total = 0
    foreach (n in doubled) {
        total += n
    }

    var words = ["rust", "varg", "ai", "agent", "compile", "type", "safe", "fast", "native", "async"]
    var freq = {"seed": 0}
    var j = 0
    while j < 10000 {
        var word = words[j % 10]
        freq[word] = (freq[word] or 0) + 1
        j += 1
    }

    var elapsed = time_millis() - start
    print $"Sum: {total}"
    print $"Freq entries: {freq.keys().len()}"
    print $"Time: {elapsed}ms"
}
