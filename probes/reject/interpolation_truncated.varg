// @probe reject: the rest was not read
// The mini-parser inside `${...}` stopped at the first thing it could not continue and nothing
// looked at the remainder, so an expression it only half understood printed the value of the
// half it did: a plausible wrong value, in silence, in the construct the language is most used
// through.
agent Main { public void Run() { var a = 5; var b = 2; print $"{a b}"; } }
