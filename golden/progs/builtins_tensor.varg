/// End-to-end coverage for the tensor reductions (feature `tensor`, auto-enabled by vargc).
fn check(string name, string got, string want) -> string {
    if got == want { return $"OK   {name}"; }
    return $"FAIL {name}: got `{got}` want `{want}`";
}

agent Main {
    public void Run() {
        var t = tensor_from_list([1.0, 2.0, 3.0, 4.0], [2, 2]);

        print check("tensor_sum", $"{tensor_sum(t)}", "10");
        print check("tensor_mean", $"{tensor_mean(t)}", "2.5");
        print check("tensor_min", $"{tensor_min(t)}", "1");
        print check("tensor_max", $"{tensor_max(t)}", "4");

        var a = tensor_from_list([1.0, 2.0, 3.0], [3]);
        var b = tensor_from_list([4.0, 5.0, 6.0], [3]);
        // 1*4 + 2*5 + 3*6 = 32
        print check("tensor_dot", $"{tensor_dot(a, b)}", "32");

        var z = tensor_zeros([2, 3]);
        print check("tensor_zeros_sum", $"{tensor_sum(z)}", "0");
        var o = tensor_ones([2, 3]);
        print check("tensor_ones_sum", $"{tensor_sum(o)}", "6");
        var i = tensor_eye(3);
        print check("tensor_eye_sum", $"{tensor_sum(i)}", "3");

        var shape = tensor_shape(t);
        print check("tensor_shape", $"{shape.len()}", "2");
        var flat = tensor_to_list(t);
        print check("tensor_to_list", $"{flat.len()}", "4");

        var scaled = tensor_mul_scalar(a, 2.0);
        print check("tensor_mul_scalar", $"{tensor_sum(scaled)}", "12");
        var added = tensor_add(a, b);
        print check("tensor_add", $"{tensor_sum(added)}", "21");
        var subbed = tensor_sub(b, a);
        print check("tensor_sub", $"{tensor_sum(subbed)}", "9");
    }
}
