/// End-to-end coverage for the JSON accessor/mutator family.
fn check(string name, string got, string want) -> string {
    if got == want { return $"OK   {name}"; }
    return $"FAIL {name}: got `{got}` want `{want}`";
}
fn yn(bool b) -> string {
    if b { return "true"; }
    return "false";
}

agent Main {
    public void Run() {
        var raw = "{\"name\": \"ada\", \"age\": 36, \"active\": true, \"tags\": [\"x\", \"y\"]}";
        // `json_parse` is fallible now, and the accessors take a raw string anyway, so the
        // parse hop is only worth making when the point is to find out whether it parses.
        print check("json_parse_ok", yn(json_parse(raw).is_ok()), "true");
        print check("json_parse_bad", yn(json_parse("{not json").is_err()), "true");

        print check("json_get", (json_get(raw, "name") or "<missing>"), "ada");
        var age = (json_get_int(raw, "age") or -1);
        print check("json_get_int", $"{age}", "36");
        var act = (json_get_bool(raw, "active") or false);
        print check("json_get_bool", yn(act), "true");
        var tags = (json_get_array(raw, "tags") or ["<missing>"]);
        print check("json_get_array", $"{tags.len()}", "2");

        var has_name = json_has(raw, "name");
        var has_zzz = json_has(raw, "zzz");
        print check("json_has_true", yn(has_name), "true");
        print check("json_has_false", yn(has_zzz), "false");

        // json_set on a raw string, then read the new value back.
        // Fallible: an unparseable document used to be replaced by an empty one, so the
        // write "succeeded" with everything else in the document gone.
        var updated = json_set(raw, "city", "vienna") or "<set failed>";
        print check("json_set_reports_junk",
                    json_set("not json", "a", "1") or "<document broken>",
                    "<document broken>");
        print check("json_set", (json_get(updated, "city") or "<missing>"), "vienna");
        print check("json_set_keeps", (json_get(updated, "name") or "<missing>"), "ada");

        // json_merge: right side wins on conflict, new keys are added.
        var patch = "{\"age\": 41, \"role\": \"admin\"}";
        var merged = json_merge(raw, patch) or "<merge failed>";
        // A side that will not parse used to vanish in silence, which looked exactly like a
        // merge that legitimately changed nothing.
        print check("json_merge_reports_left",
                    json_merge("not json", patch) or "<left broken>", "<left broken>");
        print check("json_merge_reports_right",
                    json_merge(raw, "not json") or "<right broken>", "<right broken>");
        var merged_age = (json_get_int(merged, "age") or -1);
        print check("json_merge_override", $"{merged_age}", "41");
        print check("json_merge_add", (json_get(merged, "role") or "<missing>"), "admin");
        print check("json_merge_keeps", (json_get(merged, "name") or "<missing>"), "ada");

        // Round-trip: stringify then read back. The accessors read a raw JSON string, but
        // `json_stringify` serialises whatever it is handed — hand it the raw text and it
        // produces a JSON *string* containing that text, not the object again. So the
        // round-trip goes through an actually-parsed value, which `json_parse` only yields to
        // a caller that can propagate its failure.
        print check("json_stringify", self.round_trip_name(raw) or "<err>", "ada");
        print check("json_stringify_pretty", yn(self.pretty_is_multiline(raw) or false), "true");
    }

    string round_trip_name(string doc) {
        var j = json_parse(doc)?;
        return json_get(json_stringify(j), "name") or "<missing>";
    }

    bool pretty_is_multiline(string doc) {
        var j = json_parse(doc)?;
        return json_stringify_pretty(j).contains("\n");
    }
}
