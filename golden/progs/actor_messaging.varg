/// The actor model end-to-end. Every line here used to compile, run, exit 0 — and do nothing:
/// `send("process", ..)` fell through the dispatcher's `_ => "unknown"` arm because only a
/// message literally named after a method was routed, and `on_start`/`on_stop` were emitted but
/// never called. Silent no-ops, so no test noticed.
/// An agent that is handed its dependency and then spawned. `spawn Named(arg)` called
/// `Named::new()` for any agent with fields — whatever stood in the parentheses — and the
/// constructor was also turned into a message arm, invoking an associated function as a method.
/// The documented way to spawn an agent with a dependency type-checked and then failed in rustc.
contract IGreeting {
    string greet(string who);
}

agent Polite implements IGreeting {
    public string greet(string who) { return "hello " + who; }
}

agent Greeter {
    IGreeting style;

    public Greeter(IGreeting style) {
        self.style = style;
    }

    public void on_message(string method, string[] args) {
        if method == "greet" {
            print "greeter: " + self.style.greet(args[0]);
        }
    }
}

agent Worker {
    int handled;

    public void on_start() {
        handled = 0;
        print "worker: on_start";
    }

    public void on_message(string method, string[] args) {
        if method == "process" {
            handled += 1;
            print $"worker: processed {args[0]} (#{handled})";
        }
        if method == "unknown_op" {
            print "worker: fell through to mailbox";
        }
    }

    // Direct RPC still takes precedence over the mailbox.
    public string ping(string who) {
        return $"pong:{who}";
    }
}

agent Main {
    public void Run() {
        // Spawned with its dependency handed in.
        var g = spawn Greeter(Polite {});
        g.send("greet", ["world"]);
        sleep(120);

        var w = spawn Worker();
        w.send("process", "alpha");
        w.send("process", "beta");
        w.send("unknown_op");
        var reply = w.request("ping", "main");
        print $"main: {reply}";
        sleep(200);
        print "main: done";
    }
}
