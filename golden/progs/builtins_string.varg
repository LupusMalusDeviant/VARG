/// End-to-end coverage for the string and number-formatting builtins.
///
/// Self-checking on purpose: each line prints OK or FAIL together with the expected value, so a
/// wrong result shows up in the diff instead of being silently baked into the golden file. That
/// is the failure mode this net exists for — `abs(-5.0)` returning -5 survived 1194 unit tests
/// because no program ever checked what it computed.
fn check(string name, string got, string want) -> string {
    if got == want {
        return $"OK   {name}";
    }
    return $"FAIL {name}: got `{got}` want `{want}`";
}

fn yn(bool b) -> string {
    if b { return "true"; }
    return "false";
}

agent Main {
    public void Run() {
        var s = "  Hello Varg  ";
        var t = s.trim();

        print check("to_lower", t.to_lower(), "hello varg");
        print check("to_upper", t.to_upper(), "HELLO VARG");
        print check("trim_start", s.trim_start(), "Hello Varg  ");
        print check("trim_end", s.trim_end(), "  Hello Varg");
        print check("ltrim", s.ltrim(), "Hello Varg  ");
        print check("rtrim", s.rtrim(), "  Hello Varg");
        print check("replace", t.replace("Varg", "World"), "Hello World");
        print check("substring", t.substring(0, 5), "Hello");
        print check("repeat", "ab".repeat(3), "ababab");
        print check("char_at", t.char_at(1), "e");
        print check("pad_left", "7".pad_left(4), "   7");
        print check("pad_right", "7".pad_right(4), "7   ");

        var sw = t.starts_with("Hello");
        var ew = t.ends_with("Varg");
        var ct = t.contains("lo V");
        var cf = t.contains("zzz");
        var empty_no = t.is_empty();
        var blank = "";
        var empty_yes = blank.is_empty();
        print check("starts_with", yn(sw), "true");
        print check("ends_with", yn(ew), "true");
        print check("contains", yn(ct), "true");
        print check("contains_false", yn(cf), "false");
        print check("is_empty_false", yn(empty_no), "false");
        print check("is_empty_true", yn(empty_yes), "true");

        var n = t.length();
        print check("length", $"{n}", "10");
        var dashes = "a-b-c-d";
        var occ = dashes.count_occurrences("-");
        print check("count_occurrences", $"{occ}", "3");

        var num = 42;
        print check("to_string_int", num.to_string(), "42");
        var big = 255;
        print check("to_hex", big.to_hex(), "ff");
        var five = 5;
        print check("to_binary", five.to_binary(), "101");
        var pi = 3.14159;
        print check("to_fixed", pi.to_fixed(2), "3.14");

        // The spellings that are legal, pinned because a rule now rejects the ones that are not.
        // The string and collection builtins are methods on the value: `to_upper("abc")` used to
        // type-check and then compile to `self.to_uppercase()`, so rustc complained that `&mut A`
        // has no such method. Three shapes have to keep working.

        // 1. The method form itself.
        print check("method_form", "abc".to_upper(), "ABC");

        // 2. The pipe operator, which feeds the left value in as the receiver — this reads like
        //    the free-function spelling and must not be caught by the same rule.
        var loud = "ada" |> to_upper();
        print check("pipe_form", loud, "ADA");
        var clean = "a b " |> replace(" ", "_") |> trim();
        print check("pipe_chain", clean, "a_b_");

        // 3. `len`/`length` are the one pair that reads both ways, so each spelling has its own
        //    argument count: the free one takes the value, the method one takes nothing.
        print check("len_free", $"{len("abcd")}", "4");
        print check("len_method", $"{"abcd".len()}", "4");
        var xs = [1, 2, 3];
        print check("len_free_list", $"{len(xs)}", "3");
        print check("length_free", $"{length("ab")}", "2");
    }
}
